---
// Header override: keep Starlight's default site title (logo), then add a primary
// "API" entry point in the top bar so the reference is reachable as its own
// destination, not only from the sidebar.
import Default from '@astrojs/starlight/components/SiteTitle.astro';
---

<Default><slot /></Default>
<nav class="top-nav" aria-label="Primary">
	<a href="/getting-started/"><span class="nav-full">Documentation</span><span class="nav-abbr">Doc</span></a>
	<a href="/reference/">API</a>
	<a href="https://pryv.github.io/www/">WWW</a>
</nav>

<style>
	.top-nav {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-inline-start: 1rem;
	}
	/* Three identical buttons. */
	.top-nav a {
		padding: 0.3rem 0.8rem;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		border-radius: 0.25rem;
		text-decoration: none;
		white-space: nowrap;
		color: #fff;
		background: var(--pryv-blue, #266c9c);
	}
	.top-nav a:hover { filter: brightness(1.1); }
	.nav-abbr { display: none; }
	/* Keep all three visible on mobile: compact them and abbreviate Documentation to
	   "Doc" so they always fit next to the logo. The title-wrapper clips by default;
	   allow the buttons to show. */
	:global(.title-wrapper:has(.top-nav)) { overflow: visible; }
	@media (max-width: 34rem) {
		.top-nav { gap: 0.25rem; margin-inline-start: 0.4rem; }
		.top-nav a { padding: 0.25rem 0.45rem; font-size: var(--sl-text-xs); letter-spacing: 0; }
		.nav-full { display: none; }
		.nav-abbr { display: inline; }
	}
</style>
