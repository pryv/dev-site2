---
// Header override: keep Starlight's default site title (logo), then add a primary
// "API" entry point in the top bar so the reference is reachable as its own
// destination, not only from the sidebar.
import Default from '@astrojs/starlight/components/SiteTitle.astro';
---

<Default><slot /></Default>
<nav class="top-nav">
	<a href="/getting-started/">Documentation</a>
	<a href="/reference/">API</a>
</nav>

<style>
	.top-nav {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-inline-start: 1rem;
	}
	/* Two identical buttons. */
	.top-nav a {
		padding: 0.3rem 0.8rem;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		border-radius: 0.25rem;
		text-decoration: none;
		white-space: nowrap;
		color: #fff;
		background: var(--pryv-blue, #266c9c);
	}
	.top-nav a:hover { filter: brightness(1.1); }
	/* Hide on narrow viewports where the title-wrapper clips; the sidebar still
	   exposes navigation there. */
	@media (max-width: 36rem) {
		.top-nav { display: none; }
	}
</style>
