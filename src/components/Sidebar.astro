---
// Sidebar override: the API reference is its own section with its own left-hand
// navigation (the reference outline), separate from the rest of the docs which keep
// the default site sidebar. On reference routes we render the current page's outline
// (level-1 sections as groups, level-2 sections as in-page links); everywhere else we
// defer to Starlight's default sidebar.
import Default from '@astrojs/starlight/components/Sidebar.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import { userSections, systemSection } from '../reference-data';
import { adminSections } from '../reference-data/admin';
import { headingSlug } from '../reference-data/slug';
import { isVisible } from '../reference-data/render';
import type { Section, ReferenceFlavor } from '../reference-data/types';

// Strip the deploy base (e.g. /dev-site2) so route matching works at root AND under a
// project-pages subpath.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
let path = Astro.url.pathname.replace(/\/$/, '');
if (base && path.startsWith(base)) path = path.slice(base.length);
// Each route carries the SAME flavor its page passes to ReferencePage, so the outline is
// filtered by the identical visibility rule the renderer uses (otherwise the light page,
// which hides trusted-only sections, would list dead anchors).
const REF: Record<string, { sections: Section[]; flavor: ReferenceFlavor }> = {
	'/reference': { sections: userSections, flavor: { source: 'default', showTrustedOnlyContent: true } },
	'/reference-light': { sections: userSections, flavor: { source: 'default', showTrustedOnlyContent: false } },
	'/reference-preview': { sections: userSections, flavor: { source: 'default', showTrustedOnlyContent: true, showPreviewOnlyContent: true } },
	'/reference-system': { sections: systemSection.sections ?? [], flavor: { source: 'system', showTrustedOnlyContent: true } },
	'/reference-admin': { sections: adminSections, flavor: { source: 'admin' } },
};
const ref = REF[path];

type Entry =
	| { type: 'link'; href: string; label: string; isCurrent: boolean; attrs: Record<string, unknown> }
	| { type: 'group'; label: string; collapsed: boolean; entries: Entry[] };

// Level-1 sections become groups; their level-2 children become in-page anchor links.
// Anchors use the same text-based slug as the rendered heading ids so they resolve.
// Both levels are filtered through the renderer's isVisible(); a group whose children are
// all hidden for this flavor is dropped so the sidebar never advertises a missing section.
function outline (roots: Section[], flavor: ReferenceFlavor): Entry[] {
	return roots
		.filter((l1) => l1.title && isVisible(l1, flavor))
		.map((l1) => ({
			type: 'group' as const,
			label: l1.title as string,
			collapsed: false,
			entries: (l1.sections ?? [])
				.filter((l2) => l2.title && isVisible(l2, flavor))
				.map((l2) => ({
					type: 'link' as const,
					href: '#' + headingSlug(l2.title as string),
					label: l2.title as string,
					isCurrent: false,
					attrs: {},
				})),
		}))
		.filter((group) => group.entries.length > 0);
}
---

{ref
	? <SidebarSublist sublist={outline(ref.sections, ref.flavor)} />
	: <Default><slot /></Default>
}
